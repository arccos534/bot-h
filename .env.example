BOT_TOKEN=123456:replace_me

# Masters receive booking/cancellation notifications in Telegram.
# Format: telegram_id:display_name,telegram_id:display_name
MASTER_IDS=111111111:Анна,222222222:Мария,333333333:Егор

# Optional: admins can open every master's schedule with /master.
# Format: telegram_id,telegram_id
ADMIN_IDS=111111111

# Optional: client button "Связаться с администратором".
# Use either ADMIN_CONTACT_URL=https://t.me/username or ADMIN_USERNAME=username.
ADMIN_CONTACT_URL=
ADMIN_USERNAME=

# Optional SQLite path. Defaults to salon.sqlite3.
DB_PATH=salon.sqlite3
